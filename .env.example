# App
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=info
ENVIRONMENT=local
SECRET_KEY=dev-secret-change-me-in-production
CORS_ORIGINS=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql+psycopg://eb:eb@localhost:5432/enterprise_brain

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=eb_chunks

# Redis
REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO)
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_ACCESS_KEY=minioadmin
OBJECT_STORE_SECRET_KEY=minioadmin
OBJECT_STORE_BUCKET=enterprise-brain
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_USE_SSL=false

# Auth: "dev" for local JWT; swap to clerk|keycloak|auth0 later
AUTH_PROVIDER=dev
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
DEV_ADMIN_EMAIL=admin@enterprisebrain.local
DEV_ADMIN_PASSWORD=admin123
DEV_USER_EMAIL=user@enterprisebrain.local
DEV_USER_PASSWORD=user123

# LLM / Embeddings (optional for MVP scaffold — stubs used if unset)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Feature flags
FF_GRAPHQL=false
FF_CONNECTORS=false
FF_RESEARCH_AGENT=false
