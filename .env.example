# App
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=info
ENVIRONMENT=local
SECRET_KEY=dev-secret-change-me-in-production
CORS_ORIGINS=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql+psycopg://eb:eb@localhost:5432/enterprise_brain

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=eb_chunks

# Redis / ingest queue
REDIS_URL=redis://localhost:6379/0
QUEUE_BACKEND=memory
QUEUE_INLINE=true
CONNECTOR_AUTO_INGEST=true
EVENT_BUS_BACKEND=memory
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_INGEST=eb.ingest.events
QUEUE_MAX_DEPTH=10000
DEFAULT_TENANT_ID=default
HYBRID_GRAPH_HOPS=1
HYBRID_RERANK=true
AUTO_LINK_MIN_CONFIDENCE=0.55

# Object storage (MinIO)
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_ACCESS_KEY=minioadmin
OBJECT_STORE_SECRET_KEY=minioadmin
OBJECT_STORE_BUCKET=enterprise-brain
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_USE_SSL=false

# Auth: "dev" for local only; use "oidc" for pilot/staging/production
AUTH_PROVIDER=dev
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_INVITE_EXPIRE_HOURS=72
REFRESH_TOKEN_EXPIRE_DAYS=14
ACCESS_TOKEN_EXPIRE_MINUTES=720
DEV_ADMIN_EMAIL=admin@enterprisebrain.local
DEV_ADMIN_PASSWORD=admin123
DEV_USER_EMAIL=user@enterprisebrain.local
DEV_USER_PASSWORD=user123

# LLM / Embeddings
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
REQUIRE_LLM_KEY=false
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384

# Slack / GitHub OAuth + webhooks (Phase 4 live connectors)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_REDIRECT_URI=

# Microsoft (Teams / Outlook)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=

# Google (Drive / Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Jira / Atlassian
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=
JIRA_CLOUD_ID=
JIRA_BASE_URL=

# Feature flags
FF_GRAPHQL=false
FF_CONNECTORS=false
FF_RESEARCH_AGENT=false
